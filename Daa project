<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALGO NEXUS — Intelligent Algorithm Visualization & Performance Lab</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        navy: {
                            900: '#0a0f1d',
                            800: '#0f172a',
                            700: '#1e293b',
                            600: '#334155'
                        },
                        neon: {
                            cyan: '#00f0ff',
                            violet: '#a855f7',
                            pink: '#ec4899',
                            green: '#10b981',
                            amber: '#f59e0b'
                        }
                    },
                    boxShadow: {
                        'neon-cyan': '0 0 15px rgba(0, 240, 255, 0.4)',
                        'neon-violet': '0 0 15px rgba(168, 85, 247, 0.4)'
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome & Lucide Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #070b14;
            color: #e2e8f0;
            overflow-x: hidden;
        }
        .code-font {
            font-family: 'Fira Code', monospace;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0f1d;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00f0ff;
        }
        /* Glassmorphism */
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 240, 255, 0.15);
        }
        .glass-panel-violet {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(168, 85, 247, 0.15);
        }
        .neon-border-cyan {
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
            border: 1px solid rgba(0, 240, 255, 0.4);
        }
        .neon-border-violet {
            box-shadow: 0 0 10px rgba(168, 85, 247, 0.2);
            border: 1px solid rgba(168, 85, 247, 0.4);
        }
        /* Pulse Animation */
        @keyframes glowPulse {
            0%, 100% { opacity: 0.8; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.02); }
        }
        .animate-glow {
            animation: glowPulse 3s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- TOP NAVIGATION BAR -->
    <header class="glass-panel sticky top-0 z-50 px-4 py-3 border-b border-cyan-500/20">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
            <!-- Brand Logo -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('visualizer')">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-neon-cyan to-neon-violet flex items-center justify-center text-navy-900 font-extrabold text-xl shadow-neon-cyan">
                    <i class="fa-solid to-navy-900 fa-diagram-project"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-white to-neon-violet text-lg md:text-xl tracking-wide">
                        ALGO<span class="text-neon-cyan">NEXUS</span>
                    </h1>
                    <p class="text-[10px] text-cyan-400/80 tracking-widest uppercase font-mono">MCA Algorithm Lab & Visualizer</p>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="flex items-center space-x-1 md:space-x-2 overflow-x-auto py-1">
                <button onclick="switchTab('visualizer')" id="nav-visualizer" class="nav-btn active px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all duration-200 flex items-center space-x-2 bg-cyan-500/20 text-neon-cyan border border-cyan-500/40">
                    <i class="fa-solid fa-play text-xs"></i>
                    <span>Visualizer</span>
                </button>
                <button onclick="switchTab('recommender')" id="nav-recommender" class="nav-btn px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all duration-200 flex items-center space-x-2">
                    <i class="fa-solid fa-brain text-xs"></i>
                    <span>Recommender</span>
                </button>
                <button onclick="switchTab('benchmarks')" id="nav-benchmarks" class="nav-btn px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all duration-200 flex items-center space-x-2">
                    <i class="fa-solid fa-chart-line text-xs"></i>
                    <span>Performance Lab</span>
                </button>
                <button onclick="switchTab('viva')" id="nav-viva" class="nav-btn px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all duration-200 flex items-center space-x-2">
                    <i class="fa-solid fa-book-open text-xs"></i>
                    <span>DAA Prep & Viva</span>
                </button>
                <button onclick="switchTab('quiz')" id="nav-quiz" class="nav-btn px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all duration-200 flex items-center space-x-2">
                    <i class="fa-solid fa-gamepad text-xs"></i>
                    <span>Quiz Engine</span>
                </button>
                <button onclick="switchTab('backend')" id="nav-backend" class="nav-btn px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all duration-200 flex items-center space-x-2">
                    <i class="fa-solid fa-code text-xs"></i>
                    <span>Backend & Docs</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">

        <!-- ========================================== -->
        <!-- TAB 1: FULL VISUALIZER MODULE              -->
        <!-- ========================================== -->
        <section id="tab-visualizer" class="tab-content space-y-6">
            <!-- Controls Header -->
            <div class="glass-panel p-4 md:p-6 rounded-2xl border border-slate-800 space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800/80 pb-4">
                    <!-- Algorithm Selector -->
                    <div>
                        <label class="block text-xs font-mono text-cyan-400 mb-1 uppercase tracking-wider">Select Algorithm</label>
                        <select id="algo-select" onchange="onAlgoChange()" class="bg-navy-900 text-white text-sm font-semibold rounded-lg px-3 py-2 border border-slate-700 focus:outline-none focus:border-neon-cyan w-full md:w-64 cursor-pointer">
                            <optgroup label="Sorting Algorithms">
                                <option value="bubble" selected>Bubble Sort</option>
                                <option value="selection">Selection Sort</option>
                                <option value="insertion">Insertion Sort</option>
                                <option value="merge">Merge Sort</option>
                                <option value="quick">Quick Sort</option>
                            </optgroup>
                            <optgroup label="Searching Algorithms">
                                <option value="linear">Linear Search</option>
                                <option value="binary">Binary Search (Auto-sorts)</option>
                            </optgroup>
                            <optgroup label="Graph Algorithms">
                                <option value="bfs">Breadth-First Search (BFS)</option>
                                <option value="dfs">Depth-First Search (DFS)</option>
                                <option value="dijkstra">Dijkstra's Shortest Path</option>
                            </optgroup>
                        </select>
                    </div>

                    <!-- Array Controls (Shown only for Sorting/Searching) -->
                    <div id="array-controls" class="flex flex-wrap items-center gap-4">
                        <div>
                            <label class="block text-xs font-mono text-slate-400 mb-1">Array Size: <span id="size-val" class="text-neon-cyan font-bold">15</span></label>
                            <input type="range" id="array-size" min="5" max="30" value="15" oninput="generateNewArray()" class="w-28 md:w-36 accent-neon-cyan cursor-pointer">
                        </div>
                        <div>
                            <label class="block text-xs font-mono text-slate-400 mb-1">Target Search Value</label>
                            <input type="number" id="target-value" value="42" class="bg-navy-900 border border-slate-700 text-xs rounded-lg px-2 py-1.5 w-20 text-center text-neon-cyan focus:outline-none focus:border-neon-cyan">
                        </div>
                        <div class="flex items-end">
                            <button onclick="generateNewArray()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-lg text-xs text-white transition-all">
                                <i class="fa-solid fa-shuffle mr-1"></i> Randomize Data
                            </button>
                        </div>
                    </div>

                    <!-- Graph Controls (Shown only for Graph Algos) -->
                    <div id="graph-controls" class="hidden flex-wrap items-center gap-3">
                        <button onclick="resetGraphToDefault()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-lg text-xs text-white">
                            <i class="fa-solid fa-rotate-left mr-1"></i> Reset Graph
                        </button>
                        <button onclick="clearGraphCanvas()" class="px-3 py-1.5 bg-red-950/60 border border-red-800 hover:bg-red-900/60 rounded-lg text-xs text-red-300">
                            <i class="fa-solid fa-trash mr-1"></i> Clear Nodes
                        </button>
                        <span class="text-xs text-slate-400 font-mono hidden md:inline">Click empty area to add node. Click node then drag to another to connect.</span>
                    </div>
                </div>

                <!-- Playback & Speed Controls -->
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center space-x-2">
                        <button id="btn-step-back" onclick="stepBackward()" class="px-3 py-2 bg-navy-900 hover:bg-slate-800 border border-slate-700 text-white rounded-lg text-xs disabled:opacity-40" title="Step Back">
                            <i class="fa-solid fa-backward-step"></i>
                        </button>
                        <button id="btn-play" onclick="togglePlayPause()" class="px-5 py-2 bg-gradient-to-r from-neon-cyan to-blue-600 text-navy-900 font-bold rounded-lg text-sm shadow-neon-cyan hover:opacity-90 transition-all flex items-center space-x-2">
                            <i id="play-icon" class="fa-solid fa-play"></i>
                            <span id="play-text">Start Step execution</span>
                        </button>
                        <button id="btn-step-forward" onclick="stepForward()" class="px-3 py-2 bg-navy-900 hover:bg-slate-800 border border-slate-700 text-white rounded-lg text-xs disabled:opacity-40" title="Step Forward">
                            <i class="fa-solid fa-forward-step"></i>
                        </button>
                        <button onclick="resetVisualization()" class="px-3 py-2 bg-navy-900 hover:bg-slate-800 border border-slate-700 text-slate-300 rounded-lg text-xs">
                            <i class="fa-solid fa-rotate mr-1"></i> Reset
                        </button>
                    </div>

                    <!-- Speed Control Slider -->
                    <div class="flex items-center space-x-3">
                        <i class="fa-solid fa-gauge-high text-xs text-neon-cyan"></i>
                        <span class="text-xs font-mono text-slate-400">Speed:</span>
                        <input type="range" id="speed-slider" min="50" max="1000" value="400" dir="rtl" class="w-24 md:w-32 accent-neon-violet cursor-pointer">
                        <span id="speed-display" class="text-xs font-mono text-neon-violet font-bold">1x</span>
                    </div>
                </div>
            </div>

            <!-- Visualization Canvas / Display Area -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Main Visual Display (2 Cols) -->
                <div class="lg:col-span-2 glass-panel p-6 rounded-2xl relative min-h-[380px] flex flex-col justify-between overflow-hidden">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center space-x-2">
                            <span class="inline-block w-2.5 h-2.5 rounded-full bg-neon-cyan animate-pulse"></span>
                            <h3 id="visual-title" class="text-sm font-mono font-bold text-slate-200">Execution Canvas</h3>
                        </div>
                        <div class="text-xs font-mono px-2.5 py-1 rounded bg-navy-900 text-cyan-400 border border-slate-800" id="step-counter">
                            Step 0 / 0
                        </div>
                    </div>

                    <!-- Dynamic Render Container (Bar Chart or Canvas Graph) -->
                    <div id="render-area" class="w-full flex-grow flex items-end justify-center min-h-[280px] relative border border-slate-800/60 rounded-xl bg-navy-900/60 p-4">
                        <!-- Bars Container (Sorting/Searching) -->
                        <div id="bars-container" class="w-full h-full flex items-end justify-center space-x-1.5 md:space-x-2"></div>
                        <!-- Canvas Node Editor (Graph) -->
                        <canvas id="graph-canvas" class="hidden absolute inset-0 w-full h-full cursor-crosshair"></canvas>
                    </div>

                    <!-- Color Legend Bar -->
                    <div class="mt-4 flex flex-wrap items-center justify-around gap-2 text-[11px] font-mono text-slate-400 bg-navy-900/90 p-2 rounded-lg border border-slate-800">
                        <div class="flex items-center space-x-1.5"><span class="w-3 h-3 rounded bg-cyan-500 inline-block"></span><span>Default</span></div>
                        <div class="flex items-center space-x-1.5"><span class="w-3 h-3 rounded bg-amber-400 inline-block"></span><span>Comparing/Active</span></div>
                        <div class="flex items-center space-x-1.5"><span class="w-3 h-3 rounded bg-pink-500 inline-block"></span><span>Swapping/Updating</span></div>
                        <div class="flex items-center space-x-1.5"><span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span><span>Sorted/Visited</span></div>
                    </div>
                </div>

                <!-- Execution Stats & Trace Panel -->
                <div class="glass-panel p-6 rounded-2xl flex flex-col justify-between space-y-4">
                    <div>
                        <h3 class="text-xs font-mono uppercase tracking-wider text-neon-violet mb-3 font-bold flex items-center">
                            <i class="fa-solid fa-terminal mr-2"></i> Execution Log & Metrics
                        </h3>
                        <!-- Metrics Grid -->
                        <div class="grid grid-cols-2 gap-3 mb-4">
                            <div class="bg-navy-900 p-3 rounded-lg border border-slate-800">
                                <span class="block text-[10px] font-mono text-slate-400">Comparisons / Operations</span>
                                <span id="stat-comparisons" class="text-xl font-mono font-bold text-neon-cyan">0</span>
                            </div>
                            <div class="bg-navy-900 p-3 rounded-lg border border-slate-800">
                                <span class="block text-[10px] font-mono text-slate-400">Swaps / Updates</span>
                                <span id="stat-swaps" class="text-xl font-mono font-bold text-neon-violet">0</span>
                            </div>
                        </div>

                        <!-- Current Step Narrative Explanation -->
                        <div class="bg-navy-900 p-3 rounded-lg border border-slate-800 mb-4 min-h-[90px]">
                            <span class="block text-[10px] font-mono text-slate-500 mb-1 uppercase">Step Status</span>
                            <p id="step-narration" class="text-xs font-mono text-slate-300 leading-relaxed">
                                Select an algorithm and click Start Execution to visualize step-by-step processing.
                            </p>
                        </div>
                    </div>

                    <!-- Pseudocode Viewer with Active Highlight -->
                    <div>
                        <span class="block text-[10px] font-mono text-slate-400 mb-1 uppercase">Algorithm Pseudocode</span>
                        <div id="pseudocode-box" class="bg-navy-900/90 border border-slate-800 rounded-lg p-3 text-xs code-font text-slate-300 space-y-1 overflow-x-auto max-h-48">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- TAB 2: INTELLIGENT ALGORITHM RECOMMENDER   -->
        <!-- ========================================== -->
        <section id="tab-recommender" class="tab-content hidden space-y-6">
            <div class="glass-panel p-6 rounded-2xl border border-cyan-500/20 max-w-4xl mx-auto">
                <div class="border-b border-slate-800 pb-4 mb-6">
                    <h2 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-white flex items-center">
                        <i class="fa-solid fa-brain mr-3 text-neon-cyan"></i> Intelligent Algorithm Selection Engine
                    </h2>
                    <p class="text-xs text-slate-400 mt-1">Input your problem parameters to get an expert DAA algorithm recommendation with full asymptotic reasoning.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Input Parameters Form -->
                    <div class="space-y-4 bg-navy-900/60 p-4 rounded-xl border border-slate-800">
                        <h3 class="text-xs font-mono text-neon-cyan uppercase tracking-wider font-semibold">1. Input Dataset Characteristics</h3>
                        
                        <div>
                            <label class="block text-xs font-mono text-slate-300 mb-1">Data Structure Type</label>
                            <select id="rec-ds-type" onchange="toggleRecommenderFields()" class="w-full bg-navy-900 border border-slate-700 text-xs rounded-lg p-2.5 text-white focus:border-neon-cyan">
                                <option value="array">Linear Array / Sequence</option>
                                <option value="graph">Graph / Network Nodes</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-mono text-slate-300 mb-1">Data Scale (Element Count N)</label>
                            <select id="rec-data-scale" class="w-full bg-navy-900 border border-slate-700 text-xs rounded-lg p-2.5 text-white focus:border-neon-cyan">
                                <option value="small">Small (N &lt; 50)</option>
                                <option value="medium">Medium (50 &le; N &le; 10,000)</option>
                                <option value="large">Large Scale (N &gt; 100,000)</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-mono text-slate-300 mb-1">Initial Data Ordering State</label>
                            <select id="rec-data-state" class="w-full bg-navy-900 border border-slate-700 text-xs rounded-lg p-2.5 text-white focus:border-neon-cyan">
                                <option value="unsorted">Unsorted / Random</option>
                                <option value="nearly_sorted">Nearly Sorted / Partially Ordered</option>
                                <option value="reverse">Reverse Sorted Order</option>
                                <option value="duplicates">Contains Many Duplicate Keys</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-mono text-slate-300 mb-1">Primary Optimization Priority</label>
                            <select id="rec-priority" class="w-full bg-navy-900 border border-slate-700 text-xs rounded-lg p-2.5 text-white focus:border-neon-cyan">
                                <option value="time">Time Complexity (Maximum Execution Speed)</option>
                                <option value="space">Space Complexity (Minimal Memory Footprint - In-Place)</option>
                                <option value="simplicity">Code Simplicity & Maintainability</option>
                            </select>
                        </div>

                        <button onclick="calculateRecommendation()" class="w-full py-3 bg-gradient-to-r from-neon-cyan to-neon-violet text-navy-900 font-extrabold rounded-lg text-sm shadow-neon-cyan hover:opacity-90 transition-all flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                            <span>Generate Recommendation</span>
                        </button>
                    </div>

                    <!-- Recommendation Output Display -->
                    <div id="rec-output-box" class="glass-panel-violet p-5 rounded-xl flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[10px] font-mono uppercase bg-neon-violet/20 text-neon-violet px-2.5 py-1 rounded border border-neon-violet/30 font-bold">Optimal Pick</span>
                                <span class="text-[10px] font-mono text-slate-400" id="rec-confidence">Match Confidence: 98%</span>
                            </div>
                            <h3 id="rec-algo-title" class="text-2xl font-extrabold text-white mb-2">Quick Sort</h3>
                            <p id="rec-algo-desc" class="text-xs text-slate-300 leading-relaxed mb-4">
                                Excellent average-case time efficiency with O(1) auxiliary space when implemented in-place.
                            </p>

                            <!-- Big-O Badge Summary -->
                            <div class="grid grid-cols-2 gap-2 mb-4">
                                <div class="bg-navy-900/80 p-2.5 rounded border border-slate-800">
                                    <span class="block text-[10px] font-mono text-slate-400">Time Complexity</span>
                                    <span id="rec-time-complexity" class="text-xs font-mono font-bold text-neon-cyan">O(N log N)</span>
                                </div>
                                <div class="bg-navy-900/80 p-2.5 rounded border border-slate-800">
                                    <span class="block text-[10px] font-mono text-slate-400">Auxiliary Space</span>
                                    <span id="rec-space-complexity" class="text-xs font-mono font-bold text-neon-violet">O(log N)</span>
                                </div>
                            </div>

                            <!-- Detailed Rationale -->
                            <div class="space-y-2">
                                <h4 class="text-xs font-mono text-slate-300 font-semibold uppercase">Why this choice?</h4>
                                <ul id="rec-reasons-list" class="text-xs text-slate-400 space-y-1.5 list-disc list-inside font-mono">
                                    <li>Divides array around pivot for fast in-place processing.</li>
                                    <li>Outperforms Merge Sort in cache-locality and memory requirements.</li>
                                </ul>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-slate-800">
                            <button onclick="launchRecommendedVisualizer()" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-neon-cyan border border-cyan-500/40 rounded-lg text-xs font-mono flex items-center justify-center space-x-2">
                                <span>Load into Visualizer</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- TAB 3: PERFORMANCE BENCHMARK LAB          -->
        <!-- ========================================== -->
        <section id="tab-benchmarks" class="tab-content hidden space-y-6">
            <div class="glass-panel p-6 rounded-2xl border border-slate-800">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center">
                            <i class="fa-solid fa-chart-line mr-3 text-neon-cyan"></i> Real-time Performance Lab
                        </h2>
                        <p class="text-xs text-slate-400 mt-1">Simulate and compare empirical execution times & operations across different data distributions.</p>
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        <div>
                            <label class="block text-[10px] font-mono text-slate-400 mb-0.5">Benchmark Data Scale</label>
                            <select id="bench-scale" class="bg-navy-900 border border-slate-700 text-xs rounded-lg px-2.5 py-1.5 text-white">
                                <option value="100">100 Elements</option>
                                <option value="500" selected>500 Elements</option>
                                <option value="1000">1,000 Elements</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-mono text-slate-400 mb-0.5">Distribution</label>
                            <select id="bench-type" class="bg-navy-900 border border-slate-700 text-xs rounded-lg px-2.5 py-1.5 text-white">
                                <option value="random">Random Unsorted</option>
                                <option value="sorted">Already Sorted</option>
