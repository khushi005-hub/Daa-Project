    <!-- JAVASCRIPT LOGIC -->
    <script>
        /* ==========================================================================
           GLOBAL STATE MANAGEMENT
           ========================================================================== */
        let currentArray = [];
        let executionSteps = [];
        let currentStepIndex = 0;
        let isPlaying = false;
        let playTimer = null;
        let currentAlgorithm = 'bubble';
        let stepSpeed = 400;

        // Graph Editor State
        let graphNodes = [];
        let graphEdges = [];
        let isGraphMode = false;
        let selectedNodeForEdge = null;

        // Quiz State
        let quizIndex = 0;
        let quizScore = 0;
        let quizTimerInterval = null;
        let quizTimeLeft = 20;

        /* ==========================================================================
           TAB NAVIGATION
           ========================================================================== */
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('bg-cyan-500/20', 'text-neon-cyan', 'border', 'border-cyan-500/40');
                el.classList.add('text-slate-400');
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`nav-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-cyan-500/20', 'text-neon-cyan', 'border', 'border-cyan-500/40');
                activeBtn.classList.remove('text-slate-400');
            }

            if (tabId === 'benchmarks') {
                runBenchmarkSuite();
            } else if (tabId === 'quiz') {
                initQuizEngine();
            } else if (tabId === 'backend') {
                loadCodeFile('app');
            }
        }

        /* ==========================================================================
           VISUALIZER CORE & ALGORITHMS LOGIC
           ========================================================================== */
        window.onload = function() {
            initGraphDefaultData();
            onAlgoChange();
            setupSpeedSlider();
            setupGraphCanvasListeners();
        };

        function setupSpeedSlider() {
            const slider = document.getElementById('speed-slider');
            slider.addEventListener('input', (e) => {
                stepSpeed = parseInt(e.target.value);
                const multiplier = (1000 / stepSpeed).toFixed(1);
                document.getElementById('speed-display').innerText = multiplier + 'x';
                if (isPlaying) {
                    pauseExecution();
                    startExecution();
                }
            });
        }

        function onAlgoChange() {
            pauseExecution();
            currentAlgorithm = document.getElementById('algo-select').value;
            isGraphMode = ['bfs', 'dfs', 'dijkstra'].includes(currentAlgorithm);

            const arrayControls = document.getElementById('array-controls');
            const graphControls = document.getElementById('graph-controls');
            const barsContainer = document.getElementById('bars-container');
            const graphCanvas = document.getElementById('graph-canvas');

            if (isGraphMode) {
                arrayControls.classList.add('hidden');
                graphControls.classList.remove('hidden');
                graphControls.classList.add('flex');
                barsContainer.classList.add('hidden');
                graphCanvas.classList.remove('hidden');
                renderGraphCanvas();
            } else {
                arrayControls.classList.remove('hidden');
                graphControls.classList.add('hidden');
                graphControls.classList.remove('flex');
                barsContainer.classList.remove('hidden');
                graphCanvas.classList.add('hidden');
                generateNewArray();
            }

            updatePseudocodeView();
            resetVisualization();
        }

        function generateNewArray() {
            pauseExecution();
            const size = parseInt(document.getElementById('array-size').value);
            document.getElementById('size-val').innerText = size;
            
            currentArray = [];
            for (let i = 0; i < size; i++) {
                currentArray.push(Math.floor(Math.random() * 85) + 15);
            }

            if (currentAlgorithm === 'binary') {
                currentArray.sort((a, b) => a - b);
            }

            buildExecutionSteps();
            resetVisualization();
        }

        function buildExecutionSteps() {
            executionSteps = [];
            const arr = [...currentArray];

            if (currentAlgorithm === 'bubble') buildBubbleSortSteps(arr);
            else if (currentAlgorithm === 'selection') buildSelectionSortSteps(arr);
            else if (currentAlgorithm === 'insertion') buildInsertionSortSteps(arr);
            else if (currentAlgorithm === 'merge') buildMergeSortSteps(arr);
            else if (currentAlgorithm === 'quick') buildQuickSortSteps(arr);
            else if (currentAlgorithm === 'linear') buildLinearSearchSteps(arr);
            else if (currentAlgorithm === 'binary') buildBinarySearchSteps(arr);
            else if (['bfs', 'dfs', 'dijkstra'].includes(currentAlgorithm)) buildGraphSteps();

            document.getElementById('step-counter').innerText = `Step 0 / ${executionSteps.length - 1}`;
        }

        /* --- Bubble Sort Step Builder --- */
        function buildBubbleSortSteps(arr) {
            let n = arr.length;
            let comparisons = 0, swaps = 0;
            executionSteps.push({ arr: [...arr], active: [], sorted: [], text: "Initial unsorted array state.", comparisons, swaps });

            for (let i = 0; i < n - 1; i++) {
                for (let j = 0; j < n - i - 1; j++) {
                    comparisons++;
                    executionSteps.push({
                        arr: [...arr], active: [j, j + 1], sorted: Array.from({length: i}, (_, k) => n - 1 - k),
                        text: `Comparing elements at index ${j} (${arr[j]}) and ${j+1} (${arr[j+1]})`, comparisons, swaps
                    });
                    if (arr[j] > arr[j + 1]) {
                        swaps++;
                        let temp = arr[j]; arr[j] = arr[j + 1]; arr[j + 1] = temp;
                        executionSteps.push({
                            arr: [...arr], swapping: [j, j + 1], sorted: Array.from({length: i}, (_, k) => n - 1 - k),
                            text: `Swapped ${arr[j+1]} and ${arr[j]} because ${arr[j+1]} > ${arr[j]}`, comparisons, swaps
                        });
                    }
                }
            }
            executionSteps.push({ arr: [...arr], active: [], sorted: arr.map((_, i) => i), text: "Array completely sorted!", comparisons, swaps });
        }

        /* --- Selection Sort Step Builder --- */
        function buildSelectionSortSteps(arr) {
            let n = arr.length;
            let comparisons = 0, swaps = 0;
            executionSteps.push({ arr: [...arr], active: [], sorted: [], text: "Initial array.", comparisons, swaps });

            for (let i = 0; i < n; i++) {
                let minIdx = i;
                for (let j = i + 1; j < n; j++) {
                    comparisons++;
                    if (arr[j] < arr[minIdx]) minIdx = j;
                    executionSteps.push({ arr: [...arr], active: [j, minIdx], sorted: Array.from({length: i}, (_, k) => k), text: `Finding minimum element. Current min index: ${minIdx}`, comparisons, swaps });
                }
                if (minIdx !== i) {
                    swaps++;
                    let temp = arr[i]; arr[i] = arr[minIdx]; arr[minIdx] = temp;
                    executionSteps.push({ arr: [...arr], swapping: [i, minIdx], sorted: Array.from({length: i + 1}, (_, k) => k), text: `Swapped minimum element ${arr[i]} into sorted position ${i}`, comparisons, swaps });
                }
            }
            executionSteps.push({ arr: [...arr], active: [], sorted: arr.map((_, i) => i), text: "Selection Sort completed.", comparisons, swaps });
        }

        /* --- Insertion Sort Step Builder --- */
        function buildInsertionSortSteps(arr) {
            let n = arr.length;
            let comparisons = 0, swaps = 0;
            executionSteps.push({ arr: [...arr], active: [], sorted: [0], text: "First element is initially sorted.", comparisons, swaps });

            for (let i = 1; i < n; i++) {
                let key = arr[i];
                let j = i - 1;
                executionSteps.push({ arr: [...arr], active: [i], sorted: Array.from({length: i}, (_, k) => k), text: `Picked key element ${key} at index ${i}`, comparisons, swaps });

                while (j >= 0 && arr[j] > key) {
                    comparisons++;
                    swaps++;
                    arr[j + 1] = arr[j];
                    executionSteps.push({ arr: [...arr], swapping: [j, j + 1], sorted: [], text: `Shifted ${arr[j]} rightwards`, comparisons, swaps });
                    j--;
                }
                arr[j + 1] = key;
                executionSteps.push({ arr: [...arr], sorted: Array.from({length: i + 1}, (_, k) => k), text: `Inserted key ${key} at index ${j + 1}`, comparisons, swaps });
            }
            executionSteps.push({ arr: [...arr], sorted: arr.map((_, i) => i), text: "Insertion Sort completed.", comparisons, swaps });
        }

        /* --- Merge Sort Helper Step Builder --- */
        function buildMergeSortSteps(arr) {
            let comparisons = 0, swaps = 0;
            executionSteps.push({ arr: [...arr], active: [], sorted: [], text: "Starting Merge Sort recursion.", comparisons, swaps });

            function merge(a, l, m, r) {
                let left = a.slice(l, m + 1);
                let right = a.slice(m + 1, r + 1);
                let i = 0, j = 0, k = l;

                while (i < left.length && j < right.length) {
                    comparisons++;
                    executionSteps.push({ arr: [...a], active: [k], text: `Comparing subarray left [${left[i]}] and right [${right[j]}]`, comparisons, swaps });
                    if (left[i] <= right[j]) {
                        a[k] = left[i]; i++;
                    } else {
                        a[k] = right[j]; j++;
                        swaps++;
                    }
                    executionSteps.push({ arr: [...a], swapping: [k], text: `Placed element ${a[k]} in index ${k}`, comparisons, swaps });
                    k++;
                }
                while (i < left.length) {
                    a[k] = left[i]; i++; k++;
                    executionSteps.push({ arr: [...a], swapping: [k-1], text: `Flushed remaining left element`, comparisons, swaps });
                }
                while (j < right.length) {
                    a[k] = right[j]; j++; k++;
                    executionSteps.push({ arr: [...a], swapping: [k-1], text: `Flushed remaining right element`, comparisons, swaps });
                }
            }

            function mergeSort(a, l, r) {
                if (l >= r) return;
                let m = l + Math.floor((r - l) / 2);
                mergeSort(a, l, m);
                mergeSort(a, m + 1, r);
                merge(a, l, m, r);
            }

            mergeSort(arr, 0, arr.length - 1);
            executionSteps.push({ arr: [...arr], sorted: arr.map((_, i) => i), text: "Merge Sort completed successfully.", comparisons, swaps });
        }

        /* --- Quick Sort Step Builder --- */
        function buildQuickSortSteps(arr) {
            let comparisons = 0, swaps = 0;
            executionSteps.push({ arr: [...arr], active: [], sorted: [], text: "Starting Quick Sort.", comparisons, swaps });

            function partition(a, low, high) {
                let pivot = a[high];
                let i = low - 1;
                executionSteps.push({ arr: [...a], active: [high], text: `Selected pivot element ${pivot} at index ${high}`, comparisons, swaps });

                for (let j = low; j < high; j++) {
                    comparisons++;
                    if (a[j] < pivot) {
                        i++;
                        swaps++;
                        let temp = a[i]; a[i] = a[j]; a[j] = temp;
                        executionSteps.push({ arr: [...a], swapping: [i, j], text: `Swapped ${a[i]} and ${a[j]}`, comparisons, swaps });
                    }
                }
                swaps++;
                let temp = a[i + 1]; a[i + 1] = a[high]; a[high] = temp;
                executionSteps.push({ arr: [...a], sorted: [i + 1], text: `Placed pivot ${pivot} into its correct position ${i + 1}`, comparisons, swaps });
                return i + 1;
            }

            function quickSort(a, low, high) {
                if (low < high) {
                    let pi = partition(a, low, high);
                    quickSort(a, low, pi - 1);
                    quickSort(a, pi + 1, high);
                }
            }

            quickSort(arr, 0, arr.length - 1);
            executionSteps.push({ arr: [...arr], sorted: arr.map((_, i) => i), text: "Quick Sort completed.", comparisons, swaps });
        }

        /* --- Searching Algorithms Step Builders --- */
        function buildLinearSearchSteps(arr) {
            const target = parseInt(document.getElementById('target-value').value);
            let comparisons = 0;
            let found = false;

            for (let i = 0; i < arr.length; i++) {
                comparisons++;
                if (arr[i] === target) {
                    executionSteps.push({ arr: [...arr], sorted: [i], text: `TARGET FOUND! Element ${target} exists at index ${i}`, comparisons, swaps: 0 });
                    found = true;
                    break;
                } else {
                    executionSteps.push({ arr: [...arr], active: [i], text: `Index ${i}: Value ${arr[i]} != ${target}`, comparisons, swaps: 0 });
                }
            }
            if (!found) {
                executionSteps.push({ arr: [...arr], active: [], text: `Target ${target} not found in array.`, comparisons, swaps: 0 });
            }
        }

        function buildBinarySearchSteps(arr) {
            const target = parseInt(document.getElementById('target-value').value);
            let comparisons = 0;
            let low = 0, high = arr.length - 1;
            let found = false;

            while (low <= high) {
                let mid = Math.floor((low + high) / 2);
                comparisons++;
                executionSteps.push({ arr: [...arr], active: [mid], text: `Search window [${low}..${high}]. Checking mid index ${mid} (${arr[mid]})`, comparisons, swaps: 0 });

                if (arr[mid] === target) {
                    executionSteps.push({ arr: [...arr], sorted: [mid], text: `SUCCESS! Target ${target} located at index ${mid}`, comparisons, swaps: 0 });
                    found = true;
                    break;
                } else if (arr[mid] < target) {
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }
            if (!found) {
                executionSteps.push({ arr: [...arr], active: [], text: `Target ${target} does not exist in array.`, comparisons, swaps: 0 });
            }
        }

